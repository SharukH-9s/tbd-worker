# Required — CloudAMQP connection string from your CloudAMQP instance dashboard
AMQP_URL=amqps://username:password@hostname.rmq.cloudamqp.com/vhost

# Required — Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Required — Gotenberg service base URL
# Local dev: run `docker run --rm -p 3000:3000 gotenberg/gotenberg:8` and use http://localhost:3000
# Production (Render): use the internal DNS http://gotenberg:3000
GOTENBERG_URL=http://localhost:3000

# Required — Neon Postgres connection string (used for processed_jobs idempotency table)
# Get this from your Neon project dashboard → Connection string → enable "Pooling" mode
DATABASE_URL=postgres://postgres:tbddb@localhost:5432/Turf_BD

# Optional — set to 'production' for JSON structured logs, omit for human-readable logs
# APP_ENV=production

# Optional — controls log verbosity (default: info)
# RUST_LOG=debug
